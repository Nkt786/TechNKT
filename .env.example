# GoHighLevel API credentials
# Get your Private Integration API Key from:
# GHL → Settings → Integrations → Private Integration
GHL_API_KEY=

# Your GHL Location (sub-account) ID
# Found in GHL → Settings → Business Info → Location ID
GHL_LOCATION_ID=

# Stripe Settings
# Find your Secret key in the Stripe Dashboard (sk_test_...)
STRIPE_SECRET_KEY=

# Stripe Webhook Secret (whsec_...)
# Generated when you create an endpoint in Developers -> Webhooks or run `stripe listen` locally
STRIPE_WEBHOOK_SECRET=

# Admin Authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# TechNKT Business Contacts
TECH_NKT_WHATSAPP=919822587641

# Neon PostgreSQL Database (Neon Free Plan - AWS Singapore aws-ap-southeast-1 recommended)
# Copy from Neon Console -> Dashboard -> Connection Details (Pooled connection for serverless)
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.aws-ap-southeast-1.neon.tech/technkt?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xyz.aws-ap-southeast-1.neon.tech/technkt?sslmode=require
NEON_BRANCH=development

# Neon Object Storage (S3-compatible bucket for admin-uploaded product images)
# Standard Neon CLI export names:
AWS_ENDPOINT_URL_S3=https://your-branch.storage.c-4.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
NEON_STORAGE_BUCKET=technkt-products

# Alternative custom alias names (also supported):
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_REGION=ap-southeast-1
NEON_STORAGE_PUBLIC_URL=
