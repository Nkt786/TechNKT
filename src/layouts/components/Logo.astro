---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src }: { src?: string } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;
---

<a href="/" class="navbar-brand inline-flex items-center gap-2.5 no-underline group shrink-0 select-none" aria-label="TechNKT">
  {
    src ? (
      <ImageMod
        src={src}
        class="inline-block"
        width={logo_width.replace("px", "") * 2}
        height={logo_height.replace("px", "") * 2}
        alt={title}
        style={{
          height: logo_height.replace("px", "") + "px",
          width: logo_width.replace("px", "") + "px",
        }}
        format="webp"
      />
    ) : (
      <>
        <img
          src="/images/technkt-icon.png"
          alt="TechNKT Icon"
          width="44"
          height="44"
          class="h-10 w-10 sm:h-11 sm:w-11 rounded-xl object-contain shadow-md shadow-emerald-500/25 transition-transform duration-200 group-hover:scale-105 shrink-0"
        />
        <span
          class="text-xl sm:text-2xl font-bold text-white tracking-[-0.02em] leading-none transition-colors duration-200 group-hover:text-emerald-400"
          style="font-family: var(--font-secondary), 'Urbanist', sans-serif;"
        >
          {logo_text || "TechNKT"}
        </span>
      </>
    )
  }
</a>
