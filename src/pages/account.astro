---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/layouts/components/PageHeader.astro";

const pageData = {
  title: "My Account",
  meta_title: "My Account - TechNKT",
  description: "Manage your TechNKT orders, subscriptions, and active license keys.",
};
---

<Base {...pageData}>
  <PageHeader
    title="My Account"
    subtitle="Access your active subscriptions, order history, and instant digital credentials."
  />

  <section class="section pt-0">
    <div class="container">
      <div class="max-w-xl mx-auto">
        <div class="rounded-3xl p-8 sm:p-10 bg-light/90 border border-border backdrop-blur-xl shadow-xl relative">
          <h2 class="text-2xl font-bold text-white mb-2 text-center">
            Customer Sign In
          </h2>
          <p class="text-sm text-text mb-8 text-center">
            Sign in with the email you used during checkout to view your orders.
          </p>

          <form class="space-y-4" onsubmit="event.preventDefault(); alert('Order lookup link sent to your email!');">
            <div>
              <label class="block text-xs font-semibold text-text uppercase tracking-wider mb-2">
                Email Address
              </label>
              <input
                type="email"
                required
                placeholder="name@example.com"
                class="w-full px-5 py-3 rounded-xl bg-white/[0.04] border border-border text-white placeholder:text-text-light focus:border-primary focus:outline-none transition-colors"
              />
            </div>

            <div>
              <label class="block text-xs font-semibold text-text uppercase tracking-wider mb-2">
                Order ID or Password (Optional)
              </label>
              <input
                type="password"
                placeholder="••••••••"
                class="w-full px-5 py-3 rounded-xl bg-white/[0.04] border border-border text-white placeholder:text-text-light focus:border-primary focus:outline-none transition-colors"
              />
            </div>

            <button
              type="submit"
              class="w-full btn btn-primary py-3 rounded-xl font-semibold text-white cursor-pointer mt-2"
            >
              Sign In / Look Up Orders
            </button>
          </form>

          <div class="mt-8 pt-6 border-t border-border text-center space-y-3">
            <p class="text-xs text-text-light">
              Need immediate help with your credentials or renewal?
            </p>
            <a
              href="/contact"
              class="inline-block text-sm text-primary hover:underline font-medium"
            >
              Contact TechNKT Support &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
