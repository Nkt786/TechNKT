---
import { authenticateAdmin } from "../../lib/auth";
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminDashboard from "../../layouts/components/admin/AdminDashboard";

export const prerender = false;

if (!(await authenticateAdmin(Astro.request))) {
  return Astro.redirect("/admin/login");
}
---

<AdminLayout title="Profit & Loss / Finance — TechNKT Admin">
  <AdminDashboard client:load initialTab="finance" />
</AdminLayout>
